<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nick_safe_ctrl</name>
  <version>0.0.1</version>
  <description>
    Safety-filtered controller for Unitree Go2. Subscribes to sportmodestate,
    runs a CBF (control barrier function) obstacle-avoidance safety filter, and
    publishes sport-mode Move requests on /api/sport/request.
  </description>
  <maintainer email="yixuany@mit.edu">Yixuan</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>unitree_go</exec_depend>
  <exec_depend>unitree_api</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
